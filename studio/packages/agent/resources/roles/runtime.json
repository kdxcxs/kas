{
  "path": "./roles/runtime",
  "metadata": {
    "manifest": "/builtin/role",
    "name": "agent-runtime"
  },
  "spec": {
    "description": "Allow an Agent to inspect Agents and exchange Messages through KAS.",
    "rules": [
      {
        "manifests": [
          "/manifests/agent"
        ],
        "verbs": [
          "get",
          "list"
        ],
        "paths": [
          "/agents/**"
        ]
      },
      {
        "manifests": [
          "/manifests/thread"
        ],
        "verbs": [
          "get",
          "list"
        ],
        "paths": [
          "/threads/**"
        ]
      },
      {
        "manifests": [
          "/manifests/message"
        ],
        "verbs": [
          "get",
          "list",
          "create"
        ],
        "paths": [
          "/threads/**",
          "/messages/**"
        ]
      },
      {
        "manifests": [
          "/manifests/file"
        ],
        "verbs": [
          "get",
          "list",
          "download",
          "upload"
        ],
        "paths": [
          "/files/**"
        ]
      },
      {
        "manifests": [
          "/manifests/skill"
        ],
        "verbs": [
          "get",
          "list"
        ],
        "paths": [
          "/skills/**",
          "/users/**/skills/**",
          "/agents/**/skills/**"
        ]
      },
      {
        "manifests": [
          "/builtin/link"
        ],
        "verbs": [
          "get",
          "list",
          "create"
        ],
        "paths": [
          "/messages/**"
        ]
      }
    ]
  }
}
