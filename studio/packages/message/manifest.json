{
  "path": "/packages/studio/message/manifest",
  "manifest": "/packages/kas/manifest/manifest",
  "name": "message",
  "version": 1,
  "description": "An immutable message belonging to a Thread.",
  "paths": ["./messages/**"],
  "states": [],
  "default_state": "available",
  "initial_state": "pending",
  "resource_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "role",
      "body"
    ],
    "properties": {
      "role": {
        "type": "string",
        "enum": [
          "user",
          "assistant",
          "system"
        ]
      },
      "body": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
