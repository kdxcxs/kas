{
  "path": "./relations/user-binding",
  "metadata": {
    "manifest": "/packages/kas/relation/manifest",
    "name": "telegram-user-binding"
  },
  "spec": {
    "inverse_name": "bound-kas-user",
    "sources": [
      {
        "manifest": "/packages/kas/user/manifest",
        "paths": [
          "/packages/kas/user/users/**"
        ]
      }
    ],
    "targets": [
      {
        "manifest": "/packages/kas/user/manifest",
        "paths": [
          "/packages/studio/telegram/users/**"
        ]
      }
    ],
    "on_source_delete": "unlink",
    "on_target_delete": "unlink",
    "metadata_schema": {
      "type": "object",
      "required": [
        "configuration",
        "user_id",
        "private_chat_id",
        "bound_at"
      ],
      "properties": {
        "configuration": {
          "type": "string",
          "pattern": "^/packages/studio/telegram/integrations/"
        },
        "user_id": {
          "type": "integer"
        },
        "private_chat_id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "bound_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
