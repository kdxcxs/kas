{
  "path": "./relations/identity",
  "metadata": {
    "manifest": "/packages/kas/relation/manifest",
    "name": "telegram-identity"
  },
  "spec": {
    "inverse_name": "kas-user",
    "sources": [
      {
        "manifest": "/packages/kas/user/manifest",
        "paths": [
          "/packages/studio/telegram/users/**"
        ]
      }
    ],
    "targets": [
      {
        "manifest": ".",
        "paths": [
          "/packages/studio/telegram/integrations/**"
        ]
      }
    ],
    "on_source_delete": "unlink",
    "metadata_schema": {
      "type": "object",
      "required": [
        "user_id"
      ],
      "properties": {
        "user_id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
