{
  "path": "./relations/thread-topic",
  "metadata": {
    "manifest": "/builtin/relation",
    "name": "telegram-topic"
  },
  "spec": {
    "inverse_name": "kas-thread",
    "sources": [
      {
        "manifest": "/manifests/thread",
        "paths": [
          "/threads/**"
        ]
      }
    ],
    "targets": [
      {
        "manifest": ".",
        "paths": [
          "/telegram/**"
        ]
      }
    ],
    "on_source_delete": "unlink",
    "metadata_schema": {
      "type": "object",
      "required": [
        "managed",
        "topic_name"
      ],
      "properties": {
        "managed": {
          "const": true
        },
        "topic_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topic_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
