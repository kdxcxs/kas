{
  "metadata": {
    "path": "./roles/driver",
    "manifest": "/builtin/role",
    "name": "agent-driver"
  },
  "spec": {
    "description": "Reconcile Agent identities and create Message replies.",
    "rules": [
      {
        "manifests": [
          "/manifests/agent"
        ],
        "verbs": [
          "get",
          "list",
          "update"
        ],
        "paths": [
          "/agents/**"
        ]
      },
      {
        "manifests": [
          "/manifests/thread",
          "/manifests/message"
        ],
        "verbs": [
          "get",
          "list",
          "create"
        ],
        "paths": [
          "/threads/**",
          "/messages/**"
        ]
      },
      {
        "manifests": [
          "/manifests/session"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "update"
        ],
        "paths": [
          "/threads/**/sessions/**"
        ]
      },
      {
        "manifests": [
          "/manifests/file"
        ],
        "verbs": [
          "get",
          "list",
          "download"
        ],
        "paths": [
          "/files/**"
        ]
      },
      {
        "manifests": [
          "/manifests/skill"
        ],
        "verbs": [
          "get",
          "list"
        ],
        "paths": [
          "/skills/**",
          "/users/**/skills/**",
          "/agents/**/skills/**"
        ]
      },
      {
        "manifests": [
          "/builtin/link"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "delete"
        ],
        "paths": [
          "/agents/**",
          "/threads/**",
          "/messages/**",
          "/skills/**",
          "/users/**/skills/**"
        ]
      },
      {
        "manifests": [
          "/builtin/service-account"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "update",
          "delete"
        ],
        "paths": [
          "/agents/**/service-account"
        ]
      },
      {
        "manifests": [
          "/builtin/role"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "delete"
        ],
        "paths": [
          "/agents/**/skill-role"
        ]
      },
      {
        "manifests": [
          "/builtin/role-binding"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "delete"
        ],
        "paths": [
          "/agents/**/role-binding",
          "/agents/**/skill-role-binding"
        ]
      }
    ]
  }
}
