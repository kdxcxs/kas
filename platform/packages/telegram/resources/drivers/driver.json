{
  "path": "./driver",
  "metadata": {
    "manifest": "/builtin/driver",
    "name": "telegram-driver",
    "state": "running"
  },
  "spec": {
    "runtime": "process",
    "entrypoint": "./driver/bin/kas-telegram-driver",
    "service_account": "./service-accounts/driver",
    "manages": [
      "."
    ],
    "args": [],
    "watches": [
      {
        "manifest": "/manifests/message",
        "paths": [
          "/messages/**"
        ]
      },
      {
        "manifest": "/manifests/thread",
        "paths": [
          "/threads/**"
        ]
      },
      {
        "manifest": "/builtin/link",
        "paths": [
          "/threads/**/links/telegram/**",
          "/messages/**/links/telegram/**",
          "/messages/**/links/message-thread"
        ]
      }
    ],
    "restart": "on_failure"
  },
  "status": {
    "metadata": {
      "state": "stopped"
    },
    "spec": {}
  }
}
