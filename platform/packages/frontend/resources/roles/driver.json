{
  "path": "./roles/driver",
  "metadata": {
    "manifest": "/builtin/role",
    "name": "frontend-driver"
  },
  "spec": {
    "description": "Maintain installed FrontendPlugin bundles and serve the KAS web gateway.",
    "rules": [
      {
        "manifests": [
          "/manifests/proxy"
        ],
        "verbs": [
          "get",
          "list",
          "update"
        ],
        "paths": [
          "/proxies/**"
        ]
      },
      {
        "manifests": [
          "/manifests/frontend-plugin"
        ],
        "verbs": [
          "get",
          "list",
          "update"
        ],
        "paths": [
          "/frontend-plugins/**"
        ]
      },
      {
        "manifests": [
          "/manifests/file"
        ],
        "verbs": [
          "get",
          "list",
          "download"
        ],
        "paths": [
          "/files/frontend-plugins/**"
        ]
      },
      {
        "manifests": [
          "/builtin/link"
        ],
        "verbs": [
          "get",
          "list"
        ],
        "paths": [
          "/frontend-plugins/**"
        ]
      }
    ]
  }
}
