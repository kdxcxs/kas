{
  "path": "/packages/forge/agent/manifest",
  "manifest": "/packages/kas/manifest/manifest",
  "name": "agent",
  "version": 1,
  "description": "A Codex CLI engineering Agent with a scoped KAS identity.",
  "paths": [
    "./agents/*"
  ],
  "states": [],
  "default_state": "available",
  "initial_state": "pending",
  "resource_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "working_directory"
    ],
    "properties": {
      "working_directory": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "additionalProperties": false
  }
}

