{
  "path": "./actions/run",
  "metadata": {
    "manifest": "/packages/kas/action/manifest",
    "name": "run-agent"
  },
  "spec": {
    "description": "Run one engineering task with this Agent.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "response"
      ],
      "properties": {
        "response": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}

