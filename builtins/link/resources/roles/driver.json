{
  "path": "./roles/driver",
  "metadata": {
    "manifest": "/builtin/role",
    "name": "relationship-driver"
  },
  "spec": {
    "description": "Built-in Relationship Driver permissions",
    "rules": [
      {
        "manifests": [
          "*"
        ],
        "verbs": [
          "get",
          "list",
          "delete"
        ],
        "paths": [
          "/**"
        ]
      },
      {
        "manifests": [
          "/builtin/relation",
          "/builtin/link"
        ],
        "verbs": [
          "update"
        ],
        "paths": [
          "/**"
        ]
      }
    ]
  }
}
