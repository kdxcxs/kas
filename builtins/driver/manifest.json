{
  "path": "/packages/kas/driver/manifest",
  "manifest": "/packages/kas/manifest/manifest",
  "name": "driver",
  "version": 1,
  "description": "Defines singleton Driver Resources",
  "paths": [
    "/packages/*/*/driver"
  ],
  "resource_schema": {
    "type": "object",
    "required": [
      "runtime",
      "entrypoint",
      "service_account",
      "manages"
    ],
    "properties": {
      "manages": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "watches": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "manifest"
          ],
          "properties": {
            "manifest": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "states": [
    "stopped",
    "starting",
    "running",
    "stopping",
    "failed"
  ],
  "default_state": "stopped",
  "initial_state": "stopped"
}
