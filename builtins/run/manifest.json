{
  "path": "/packages/kas/run/manifest",
  "manifest": "/packages/kas/manifest/manifest",
  "name": "run",
  "version": 1,
  "description": "Defines Action Run Resources",
  "paths": [
    "/packages/*/*/**/runs/*"
  ],
  "resource_schema": {
    "type": "object",
    "required": [
      "request_id",
      "resource",
      "action",
      "input"
    ]
  },
  "states": [
    "queued",
    "running",
    "succeeded",
    "failed",
    "cancelled"
  ],
  "default_state": "queued",
  "initial_state": "queued"
}
