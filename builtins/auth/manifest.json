        {
          "kind": "role_binding"
        }
      ],
      "targets": [
        {
          "kind": [
            "user",
            "service_account"
          ]
        }
      ],
      "cardinality": {},
      "metadata_schema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "driver": null,
  "rbac": {
    "service_accounts": [],
    "roles": [
      {
        "path": "./roles/admin",
        "name": "system:admin",
