          }
        ]
      },
      {
        "path": "./roles/viewer",
        "name": "system:viewer",
        "description": "Read business objects",
        "system_role": "viewer",
        "rules": [
          {
            "resources": [
              "manifests",
              "actions",
              "relations",
              "resources/*",
              "drivers",
              "runs",
              "links"
            ],
            "verbs": [
              "get",
              "list",
              "watch"
            ]
          }
        ]
      }
    ],
    "role_bindings": []
