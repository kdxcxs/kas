{
  "path": "./driver",
  "metadata": {
    "manifest": "/packages/kas/driver/manifest",
    "name": "echo-driver",
    "state": "running"
  },
  "spec": {
    "runtime": "process",
    "entrypoint": "./driver/bin/kas-test-driver",
    "service_account": "./service-accounts/driver",
    "args": [],
    "watches": [
      {
        "manifest": "/packages/kas/link/manifest",
        "paths": [
          "./links/**"
        ]
      },
      {
        "manifest": "/packages/kas/user/manifest",
        "paths": [
          "/packages/kas/user/users/**"
        ]
      },
      {
        "manifest": "/packages/test/integration/manifest",
        "paths": [
          "/packages/test/integration/resources/**"
        ]
      }
    ],
    "restart": "never"
  },
  "status": {
    "metadata": {
      "state": "stopped"
    },
    "spec": {}
  }
}
