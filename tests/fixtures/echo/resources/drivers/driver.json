{
  "path": "./driver",
  "metadata": {
    "manifest": "/builtin/driver",
    "name": "echo-driver",
    "state": "running"
  },
  "spec": {
    "runtime": "process",
    "entrypoint": "./driver/bin/kas-test-driver",
    "service_account": "./service-accounts/driver",
    "args": [],
    "watches": [
      {
        "manifest": "/builtin/link",
        "paths": [
          "/links/e2e/**"
        ]
      },
      {
        "manifest": "/builtin/user",
        "paths": [
          "/users/**"
        ]
      },
      {
        "manifest": "/manifests/integration-*",
        "paths": [
          "/resources/integrations/**"
        ]
      }
    ],
    "restart": "never"
  },
  "status": {
    "metadata": {
      "state": "stopped"
    },
    "spec": {}
  }
}
